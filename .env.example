# PDF Conduit web — environment configuration (v2, two containers).
#
# Copy this file to `.env` (same directory as docker-compose.yml) and edit as
# needed. Docker Compose loads `.env` automatically. These variables also work
# when running the jar directly: `PDFCONDUIT_WEB_MAX_FILES=100 java -jar ...`.
#
#   cp .env.example .env

# =========================================================================
# Production / TLS (docker-compose.prod.yml — the Caddy edge). MUST-CHANGE
# values are marked. These are ignored by the base compose (local dev).
# =========================================================================

# Public domain Caddy provisions HTTPS for. *** MUST CHANGE for prod. ***
# Point its DNS A/AAAA record at this VPS first. For a domainless, no-TLS
# local trial set DOMAIN=:80 (Caddy then serves plain HTTP, no certs).
DOMAIN=:80

# Contact email for Let's Encrypt (cert-expiry notices). *** MUST CHANGE for
# prod (a real domain). *** Ignored when DOMAIN=:80.
ACME_EMAIL=

# JVM options for the backend. Default makes the heap track the container
# memory limit (mem_limit in docker-compose.prod.yml) and exit on OOM so
# Docker restarts the container. Pin a heap instead with e.g.
# "-Xmx1g -XX:+ExitOnOutOfMemoryError".
JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError

# OCR (tesseract is bundled in the Docker image, with eng/pol/deu/fra/spa data
# packs). Disabled by default in code — *** for a production deployment set
# true, otherwise the public OCR page returns an error. ***
PDFCONDUIT_WEB_OCR_ENABLED=true

# =========================================================================
# Base (local dev) — docker-compose.yml
# =========================================================================

# Active Spring profile → which per-environment limit PRESET the backend loads
# (application-<profile>.yml, layered over the strict base application.yml):
#   local — RELAXED, single-developer box (generous size/count/rate/concurrency).  [base compose default]
#   dev   — RELAXED, shared non-public dev/staging box (same intent as local).
#   prod  — explicit STRICT public ceilings.  docker-compose.prod.yml FORCES this
#           regardless of the value set here.
# Individual limits still override this via their own PDFCONDUIT_WEB_* env var below
# (an explicit env var wins over the profile preset).
SPRING_PROFILES_ACTIVE=local

# Host port the FRONTEND (nginx) is published on. Open http://localhost:<this>.
# The backend is not published — the browser reaches /api through nginx.
# In PROD this is unused: Caddy publishes 80/443 and the frontend port is
# dropped (see docker-compose.prod.yml).
FRONTEND_PORT=4200

# HTTP port the backend listens on INSIDE its container. Not published to the
# host in the compose topology (the frontend proxies to it over the network).
SERVER_PORT=8080

# The backend is stateless and processes uploads in memory — there is NO work
# directory / volume. The one exception is office-document conversion below.

# Office/document conversion (.docx/.xlsx/.pptx/... → PDF). This is the sole
# disk touch: LibreOffice reads/writes an isolated, immediately-deleted per-
# request temp dir. Set to false to reject office uploads with a clear 415.
PDFCONDUIT_WEB_OFFICE_ENABLED=true

# Optional absolute path to the LibreOffice `soffice` binary. Leave empty to
# auto-detect (the Docker image bundles LibreOffice, so no value is needed
# there). Set this only if `soffice` lives somewhere non-standard.
PDFCONDUIT_WEB_SOFFICE_PATH=

# CORS: comma-separated origins allowed to call /api. Needed only for the dev
# split-origin setup (ng serve on :4200 → backend on :8080). The nginx/Caddy
# proxy is same-origin, so this is irrelevant there. *** For prod, set this to
# your real origin, e.g. https://pdf.example.com. ***
PDFCONDUIT_WEB_CORS_ALLOWED_ORIGINS=http://localhost:4200

# Maximum size of a single uploaded file.
PDFCONDUIT_WEB_MAX_FILE_SIZE=100MB

# Maximum total size of one multipart request (all files combined).
PDFCONDUIT_WEB_MAX_REQUEST_SIZE=200MB

# Maximum number of files accepted in a single request (guardrail).
PDFCONDUIT_WEB_MAX_FILES=50

# =========================================================================
# Abuse protection (read by the backend; also wired through compose). These
# are the app-level half of the defense-in-depth — the edge (nginx limit_req +
# Caddy) is the other half. Defaults are tuned for a free, public instance on
# a small VPS; loosen for a bigger box, tighten if you see abuse.
# =========================================================================

# --- Per-IP request rate limiting -----------------------------------------
PDFCONDUIT_WEB_RATELIMIT_ENABLED=true
# Sustained requests/min per client for normal endpoints.
PDFCONDUIT_WEB_RATELIMIT_REQUESTS_PER_MINUTE=40
# Tighter cap for HEAVY ops (compress, office conversion, render, pipeline).
PDFCONDUIT_WEB_RATELIMIT_HEAVY_PER_MINUTE=10
# Token-bucket burst allowance above the sustained rate.
PDFCONDUIT_WEB_RATELIMIT_BURST=15

# --- Per-client daily quota / free-tier caps ------------------------------
PDFCONDUIT_WEB_QUOTA_ENABLED=true
# Operations allowed per client per day.
PDFCONDUIT_WEB_QUOTA_DAILY_OPERATIONS=60
# Free-tier per-file / per-request file-count ceilings (below the hard
# MAX_* guardrails above; these are the "fair use" limits).
PDFCONDUIT_WEB_QUOTA_FREE_MAX_FILE_SIZE=25MB
PDFCONDUIT_WEB_QUOTA_FREE_MAX_FILES=15

# --- Concurrency / in-flight memory caps (the core anti-OOM guard) --------
# Max simultaneous heavy operations across ALL clients.
PDFCONDUIT_WEB_CONCURRENCY_MAX_HEAVY_OPS=4
# Ceiling on total bytes held in memory across in-flight requests (512 MiB).
# Keep this well under the backend heap / container mem_limit.
PDFCONDUIT_WEB_CONCURRENCY_MAX_IN_FLIGHT_BYTES=536870912

# --- Per-operation limits --------------------------------------------------
# Hard wall-clock cap on a single operation before it's aborted.
PDFCONDUIT_WEB_PROCESSING_TIMEOUT_SECONDS=60
# Reject PDFs with more pages than this (guards pathological inputs).
PDFCONDUIT_WEB_PDF_MAX_PAGES=3000

# --- LibreOffice (office → PDF) -------------------------------------------
# Max concurrent soffice conversions (each is a heavy subprocess).
PDFCONDUIT_WEB_OFFICE_MAX_CONCURRENT=2
# Timeout for a single office conversion. Keep the nginx /api proxy
# read/send timeout (120s) comfortably above this.
PDFCONDUIT_WEB_OFFICE_TIMEOUT_SECONDS=90
